<?xml version="1.0"?>
<sdf version="1.6">
  <world name="camtest">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <model name="truss_test">
      <static>true</static>
      <pose>0 0 0.3 0 0 0</pose>
      <link name="link">
        <visual name="fruits">
          <geometry><mesh><uri>model://tomato1_truss/meshes/fruits.dae</uri></mesh></geometry>
          <material><ambient>0.82 0.10 0.06 1</ambient><diffuse>0.82 0.10 0.06 1</diffuse></material>
        </visual>
        <visual name="stems">
          <geometry><mesh><uri>model://tomato1_truss/meshes/stems.dae</uri></mesh></geometry>
          <material><ambient>0.22 0.40 0.14 1</ambient><diffuse>0.22 0.40 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="viewcam">
      <static>true</static>
      <pose>0.55 0 1.28 0 0 3.14159</pose>
      <link name="link">
        <sensor type="camera" name="cam">
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>20</far></clip>
          </camera>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <plugin name="cam_ros" filename="libgazebo_ros_camera.so">
            <ros><namespace>/testcam</namespace></ros>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
