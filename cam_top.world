<?xml version="1.0"?>
<sdf version="1.6">
  <world name="topview">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://greenhouse_structure</uri><pose>-8.0 -3.56 0 0 0 0</pose></include>
    <model name="topcam">
      <static>true</static>
      <pose>-26 -22 20 0 0.75 0.85</pose>
      <link name="link">
        <sensor type="camera" name="cam">
          <update_rate>1</update_rate>
          <camera><horizontal_fov>1.2</horizontal_fov><image><width>800</width><height>800</height><format>R8G8B8</format></image><clip><near>1</near><far>200</far></clip></camera>
          <always_on>true</always_on><visualize>false</visualize>
          <plugin name="pt" filename="libgazebo_ros_camera.so"><ros><namespace>/top</namespace></ros></plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
